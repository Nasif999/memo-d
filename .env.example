# Firebase web app config (Console -> Project settings -> General -> Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Admin SDK service account (Console -> Project settings -> Service accounts -> Generate new private key)
# Paste the ENTIRE JSON file content as one line:
FIREBASE_SERVICE_ACCOUNT_JSON=

# Storage bucket name (Console -> Storage), e.g. your-project.firebasestorage.app
FIREBASE_STORAGE_BUCKET=
