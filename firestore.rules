rules_version = '2';

// The browser never talks to Firestore directly — all data access goes through
// the Next.js server using the Admin SDK (which bypasses these rules). Denying
// everything here means a leaked web API key gives an attacker nothing.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
